{
  "manifest_version": 3,
  "name": "EmptyDomai - AI Domain Generator & Bulk Checker",
  "version": "1.2.0",
  "description": "Generate AI-powered domain names, bulk check availability, verify brand presence across the web - all in one extension. No API key required to start checking domains!",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "identity",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.domainr.com/*",
    "https://domain-availability.whoisxmlapi.com/*",
    "https://cloudflare-dns.com/*",
    "https://rdap.verisign.com/*",
    "https://rdap.publicinterestregistry.org/*",
    "https://rdap.nic.io/*",
    "https://rdap.nic.ai/*",
    "https://rdap.nic.co/*",
    "https://play.google.com/*",
    "https://itunes.apple.com/*",
    "https://apps.apple.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "EmptyDomai"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "oauth2": {
    "client_id": "989858667510-b3984isn5m87bpnbrarm3ii1s48rhsek.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
